          "files": [
            {
              "path": "README.md",
              "content": null
            }
          ]
        },
        {
          "truncated": false,
          "tree": []
        }
      ],
      "assert": {
        "op": "raises",
        "exception": "ValueError"
      }
    },
    {
      "name": "unchanged_blob",
      "function": "tree_entries",
      "args": [
        {
          "title": "Change",
          "body": "### Work\n\nRefs #4\n\n### Changes\n\nX\n\n### Verification\n\nTests pass",
          "files": [
            {
