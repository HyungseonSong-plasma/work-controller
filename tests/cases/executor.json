{
  "version": 1,
  "target": "controller.executor",
  "cases": [
    {
      "name": "invalid_path_1",
      "function": "validate_plan",
      "args": [
        {
          "title": "Change",
          "body": "### Work\n\nRefs #4\n\n### Changes\n\nX\n\n### Verification\n\nTests pass",
          "files": [
            {
              "path": "../x",
              "content": "new"
            }
          ]
        },
        4
      ],
      "assert": {
        "op": "raises",
        "exception": "ValueError"
      }
    },
    {
      "name": "invalid_path_2",
      "function": "validate_plan",
      "args": [
        {
          "title": "Change",
          "body": "### Work\n\nRefs #4\n\n### Changes\n\nX\n\n### Verification\n\nTests pass",
          "files": [
            {
              "path": ".git/config",
              "content": "new"
            }
          ]
        },
        4
      ],
      "assert": {
        "op": "raises",
        "exception": "ValueError"
      }
    },
    {
      "name": "invalid_path_3",
      "function": "validate_plan",
      "args": [
        {
